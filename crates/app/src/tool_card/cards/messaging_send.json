{
  "version": 1,
  "tool": "messaging_send",
  "running": {
    "title": "Sending a message…"
  },
  "failed": {
    "title": "Could not send the message"
  },
  "done": {
    "title": {
      "template": "Sent a message {$._in}"
    },
    "body": {
      "type": "stack",
      "direction": "row",
      "gap": "md",
      "children": [
        {
          "type": "avatar",
          "name": {
            "path": "$.message.author.name"
          }
        },
        {
          "type": "stack",
          "direction": "column",
          "gap": "xs",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "gap": "sm",
              "children": [
                {
                  "type": "text",
                  "value": {
                    "path": "$.message.author.name"
                  },
                  "style": "title",
                  "max_lines": 1
                },
                {
                  "type": "badge",
                  "value": {
                    "path": "$.message.origin"
                  },
                  "tone": "neutral",
                  "when": {
                    "path": "$.message.origin",
                    "exists": true
                  }
                }
              ]
            },
            {
              "type": "text",
              "value": {
                "path": "$.message.text"
              },
              "style": "body",
              "max_lines": 4
            }
          ]
        }
      ]
    },
    "footer": [
      {
        "type": "open",
        "label": "Open channel",
        "ref": {
          "path": "$.message.channel"
        }
      }
    ]
  }
}
